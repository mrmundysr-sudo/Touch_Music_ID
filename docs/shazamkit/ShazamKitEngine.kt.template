    /**
     * Records mono PCM16 at 48 kHz. Cancellation-aware: coroutine cancellation (cancel button, app backgrounded,
     * timeout) stops the loop and the finally-block releases the microphone. Nothing is written to disk.
     */
    @RequiresPermission(Manifest.permission.RECORD_AUDIO)
    private suspend fun recordMono48k(maxMillis: Long): ByteArray {
        val rate = 48_000
        val format = AudioFormat.Builder().setChannelMask(AudioFormat.CHANNEL_IN_MONO)
            .setEncoding(AudioFormat.ENCODING_PCM_16BIT).setSampleRate(rate).build()
        val minBuf = AudioRecord.getMinBufferSize(rate, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
        val record = AudioRecord.Builder().setAudioSource(MediaRecorder.AudioSource.UNPROCESSED).setAudioFormat(format).build()
        val out = ByteArrayOutputStream()
        val target = rate * 2 * (maxMillis / 1000).toInt()
        try {
            record.startRecording()
            val buf = ByteArray(minBuf)
            while (out.size() < target) {
                coroutineContext.ensureActive()
                val n = record.read(buf, 0, buf.size)
                if (n < 0) throw IllegalStateException("AudioRecord read error $n")
                out.write(buf, 0, n)
            }
        } finally {
            record.release()
        }
        return out.toByteArray()
    }
}
